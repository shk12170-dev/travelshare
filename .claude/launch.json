{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "travelshare-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "travelshare-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "BETTER_AUTH_URL": "http://localhost:3100"
      }
    },
    {
      "name": "travelshare-verify",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3101"
      ],
      "port": 3101,
      "env": {
        "BETTER_AUTH_URL": "http://localhost:3101",
        "DATABASE_URL": "file:./prisma/verify.db",
        "UPLOAD_DIR": "storage/verify-uploads"
      }
    },
    {
      "name": "travelshare-vercel-sim",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3102"
      ],
      "port": 3102,
      "env": {
        "BETTER_AUTH_URL": "http://localhost:3102",
        "DATABASE_URL": "file:./prisma/verify.db",
        "VERCEL": "1",
        "RESEND_API_KEY": "",
        "MAIL_FROM": "",
        "R2_ACCOUNT_ID": ""
      }
    }
  ]
}
