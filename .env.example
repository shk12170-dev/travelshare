# DB 위치를 바꾸고 싶을 때만 이 파일을 .env로 복사해서 수정하세요.
# 없으면 기본값 file:./prisma/dev.db 를 사용합니다.
DATABASE_URL="file:./prisma/dev.db"

# 로그인 세션 암호화 키. 운영 환경에서는 반드시 32자 이상 무작위 값으로 설정하세요.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 개발 환경에서는 비워 두면 기본값을 사용합니다.
BETTER_AUTH_SECRET=""

# 사이트 주소 (로그인 처리와 보안 검사에 사용). 운영 환경에서는 실제 주소로 설정하세요.
BETTER_AUTH_URL="http://localhost:3000"

# ─ 선택 기능 ─────────────────────────────────────────────
# 비밀번호 재설정 메일 (https://resend.com 에서 API 키 발급, 보내는 주소는 인증된 도메인이어야 함)
# 비워 두면 메일 대신 서버 콘솔에 재설정 링크가 출력됩니다(개발용).
RESEND_API_KEY=""
MAIL_FROM=""

# 소셜 로그인. 키를 넣은 서비스만 로그인 화면에 버튼이 나타납니다.
# 각 서비스의 개발자 콘솔에 리디렉션 URI로 {BETTER_AUTH_URL}/api/auth/callback/{google|kakao} 를 등록하세요.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 백업 위치와 보관 개수 (npm run db:backup). 기본: 프로젝트의 backups 폴더, 14개
BACKUP_DIR=""
BACKUP_KEEP=""

# ─ 배포용(Vercel + Turso + Cloudflare R2) ──────────────────
# 아래 값을 Vercel 프로젝트의 Environment Variables에 넣고, 같은 값을 PC의 .env에 넣으면
# npm run db:migrate:remote, npm run check:services 등을 실행할 수 있습니다.

# Turso(DB). 설정하면 로컬 파일 대신 Turso를 사용합니다.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Cloudflare R2(사진·영상 저장소). 4개가 모두 있어야 R2를 사용하고, 없으면 로컬 폴더에 저장합니다.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
