# DB 위치를 바꾸고 싶을 때만 이 파일을 .env로 복사해서 수정하세요.
# 없으면 기본값 file:./prisma/dev.db 를 사용합니다.
DATABASE_URL="file:./prisma/dev.db"

# 로그인 세션 암호화 키. 운영 환경에서는 반드시 32자 이상 무작위 값으로 설정하세요.
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 개발 환경에서는 비워 두면 기본값을 사용합니다.
BETTER_AUTH_SECRET=""

# 사이트 주소 (로그인 처리와 보안 검사에 사용). 운영 환경에서는 실제 주소로 설정하세요.
BETTER_AUTH_URL="http://localhost:3000"

# ─ 선택 기능 ─────────────────────────────────────────────
# 비밀번호 재설정 메일 (https://resend.com 에서 API 키 발급, 보내는 주소는 인증된 도메인이어야 함)
# 비워 두면 메일 대신 서버 콘솔에 재설정 링크가 출력됩니다(개발용).
RESEND_API_KEY=""
MAIL_FROM=""

# 소셜 로그인. 키를 넣은 서비스만 로그인 화면에 버튼이 나타납니다.
# 각 서비스의 개발자 콘솔에 리디렉션 URI로 {BETTER_AUTH_URL}/api/auth/callback/{google|kakao} 를 등록하세요.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
